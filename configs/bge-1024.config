# Dataset + index (shared)
dataset = /dataset/bge_10m_1024/base.bin
index = /data/idx-bge
dataset-format = auto

# Search
k = 10
ef-search = 680

# Build parameters (build_index only)
build.M = 96
build.ef-construction = 64
build.shards = 8            # must equal mpirun -np
build.threads = 0           # 0 = all cores
build.cluster = false

# Compute (bench only)
num-threads = 0
search-threads = 48
service-threads = 48
expand-batch = 10
use-dot-norm = true

# Routing (bench only)
cluster-route = false

# Benchmark
rounds = 3
warmup = 1
