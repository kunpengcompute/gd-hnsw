# Dataset + index (shared)
dataset = /dataset/gist_1M_960/base.bin
index = /data/idx-gist
dataset-format = auto

# Search
k = 10
ef-search = 355

# Build parameters (build_index only)
build.M = 64
build.ef-construction = 40
build.shards = 8            # must equal mpirun -np
build.threads = 0           # 0 = all cores
build.cluster = false

# Compute (bench only)
num-threads = 0
search-threads = 44
service-threads = 48
expand-batch = 20
use-dot-norm = true

# Routing (bench only)
cluster-route = false

# Benchmark
rounds = 3
warmup = 1
