# Dataset + index (shared)
dataset = /dataset/bigann-100m.hdf5
index = /data/idx-bigann
dataset-format = auto

# Search
k = 10
ef-search = 265

# Build parameters (build_index only)
build.M = 64
build.ef-construction = 40
build.shards = 8            # must equal mpirun -np
build.threads = 0           # 0 = all cores
build.cluster = false

# Compute (bench only)
num-threads = 0
search-threads = 64
service-threads = 30
expand-batch = 16
use-dot-norm = true

# Routing (bench only)
cluster-route = false

# Benchmark
rounds = 3
warmup = 1
